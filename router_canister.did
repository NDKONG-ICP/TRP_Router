type HeaderField = record { text; text };
type HttpRequest = record {
  method : text;
  url : text;
  headers : vec HeaderField;
  body : blob;
};
type HttpResponse = record {
  status_code : nat16;
  headers : vec HeaderField;
  body : blob;
  streaming_strategy : opt null;
};

type ProviderHealth = record {
  name : text;
  healthy : bool;
  last_error : opt text;
  circuit_open : bool;
};

type RouterStatus = record {
  providers : vec ProviderHealth;
  payments_enabled : bool;
  onchain_models_ready : bool;
};

type QuoteResult = variant { ok : nat; err : text };

service : {
  init_router : (principal) -> (); // blob_store canister id
  set_llama_qwen25 : (principal) -> (); // llama_cpp_qwen25 canister id (M3)
  set_provider_keys : (opt text, opt text, opt text) -> (); // cloudflare acct, cf token, gemini (admin)
  http_request_update : (HttpRequest) -> (HttpResponse);
  http_request : (HttpRequest) -> (HttpResponse) query;
  router_status : () -> (RouterStatus) query;
  pay_with_mock_trp_quote : (nat) -> (QuoteResult) query;
  credit_balance : () -> (nat) query;
  dev_exercise_m5_oracle : (nat, nat) -> (QuoteResult);
  dev_exercise_m5_stale_oracle : (nat) -> (QuoteResult);
  dev_exercise_m6_stake : (nat) -> (nat);
  dev_exercise_m6_byok : (bool) -> (nat);
  dev_exercise_m6_holder : (nat32) -> (bool);
};
