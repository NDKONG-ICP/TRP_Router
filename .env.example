# TRP Router — local / owner only (NEVER commit .env)

# Relay (required for off-chain chat consensus) — keys live in Worker secrets; canister gets URL + shared secret only
# RELAY_URL=https://trp-router-relay.<your-subdomain>.workers.dev/infer
# RELAY_SHARED_SECRET=

# Optional BYOK vault on canister (Anthropic per-user still via set_byok_anthropic)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Image providers (direct outcall — deterministic Pollinations bypasses relay)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# GEMINI_API_KEY=
