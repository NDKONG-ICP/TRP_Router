type BuildPhase = variant {
  c1_toolchain;
  c2_wasm_blocked;
  c3_model_ready;
  c4_inference_pending;
  c5_ready;
};

type StageTiming = record {
  stage : text;
  instructions : nat64;
  update_calls : nat32;
  wall_ms : nat64;
};

type Status = record {
  phase : BuildPhase;
  message : text;
  sd_cpp_commit : text;
  model_sha256 : opt text;
  wasm_linked : bool;
};

type BeginArgs = record {
  prompt : text;
  seed : nat64;
  steps : nat32;
  height : nat32;
  width : nat32;
};

type BeginResult = variant { ok : nat64; err : text };

type StepResult = variant {
  ok : record { step_index : nat32; instructions : nat64; wall_ms : nat64 };
  err : text;
};

type FinishResult = variant {
  ok : record { png_sha256 : text; bytes_len : nat64; timings : vec StageTiming };
  err : text;
};

service : {
  status : () -> (Status) query;
  upload_weights_chunk : (nat64, blob) -> (variant { ok; err : text });
  weights_bytes_loaded : () -> (nat64) query;
  begin : (BeginArgs) -> (BeginResult);
  step : (nat32) -> (StepResult);
  finish : () -> (FinishResult);
  last_timings : () -> (vec StageTiming) query;
};
