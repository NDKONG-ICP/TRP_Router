type BuildPhase = variant {
  c1_toolchain;
  c2_wasm_blocked;
  c3_model_ready;
  c4_inference_pending;
  c5_ready;
};

type StageTiming = record {
  stage : text;
  instructions : nat64;
  update_calls : nat32;
  wall_ms : nat64;
};

type Status = record {
  phase : BuildPhase;
  message : text;
  sd_cpp_commit : text;
  model_sha256 : opt text;
  wasm_linked : bool;
};

type BeginArgs = record {
  prompt : text;
  seed : nat64;
  steps : nat32;
  height : nat32;
  width : nat32;
  /// bit0=full_graph, bit1=v_prediction, bit3(8)=Euler ancestral (default plain Euler)
  /// bit16(0x10000)=parity embeds dump, bit17(0x20000)=parity UNet step0 dump
  debug_flags : nat32;
};

type BeginResult = variant { ok : nat64; err : text };

type StepResult = variant {
  ok : record {
    step_index : nat32;
    instructions : nat64;
    wall_ms : nat64;
    load_done : bool;
    generate_done : bool;
    tensors_this_call : nat32;
    tensors_loaded_total : nat32;
    tensors_total : nat32;
    gguf_tensors : nat32;
    bytes_loaded : nat64;
  };
  err : text;
};

type FinishResult = variant {
  ok : record { png_sha256 : text; bytes_len : nat64 };
  err : text;
};

service : {
  status : () -> (Status) query;
  upload_weights_chunk : (record { offset : nat64; chunk : blob }) -> (variant { ok; err : text });
  upload_taesd_chunk : (record { offset : nat64; chunk : blob }) -> (variant { ok; err : text });
  weights_bytes_loaded : () -> (nat64) query;
  taesd_bytes_loaded : () -> (nat64) query;
  weights_vfs_probe : () -> (
    record { vfs_size : nat64; counter_bytes : nat64; head_hex : text }
  ) query;
  begin : (BeginArgs) -> (BeginResult);
  step : (nat32) -> (StepResult);
  finish : () -> (FinishResult);
  get_png : () -> (variant { ok : blob; err : text }) query;
  last_timings : () -> (
    record {
      stage : vec text;
      instructions : vec nat64;
      update_calls : vec nat32;
      wall_ms : vec nat64;
    }
  ) query;
  parity_status : () -> (
    record {
      embeds_ready : bool;
      unet_ready : bool;
      embeds_sha256 : text;
      unet_sha256 : text;
      resume_node : nat64;
      trap_node : nat64;
      trap_instr : nat64;
    }
  ) query;
  get_parity_blob : (text) -> (
    variant { ok : blob; err : text }
  ) query;
};
