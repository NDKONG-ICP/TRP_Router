{
  "version": 1,
  "dfx": "0.29.2",
  "canisters": {
    "blob_store": {
      "type": "rust",
      "package": "blob_store",
      "candid": "blob_store.did"
    },
    "router_canister": {
      "type": "rust",
      "package": "router_canister",
      "candid": "router_canister.did",
      "dependencies": [
        "blob_store",
        "http_transform"
      ]
    },
    "http_transform": {
      "type": "rust",
      "package": "http_transform",
      "candid": "http_transform.did"
    },
    "mock_trp_ledger": {
      "type": "rust",
      "package": "mock_trp_ledger",
      "candid": "mock_trp_ledger.did"
    },
    "trp_meter": {
      "type": "rust",
      "package": "trp_meter",
      "candid": "trp_meter/trp_meter.did"
    },
    "trp_playground": {
      "type": "assets",
      "source": [
        "dist/playground"
      ]
    },
    "llama_cpp_qwen25": {
      "type": "custom",
      "wasm": "vendor/llama_cpp_canister/build/llama_cpp.wasm",
      "candid": "vendor/llama_cpp_canister/llama_cpp.did",
      "init_arg": "(record {})",
      "metadata": [
        {
          "name": "candid:service"
        }
      ]
    },
    "raven_nft": {
      "type": "rust",
      "package": "raven_nft",
      "candid": "raven_nft/raven_nft.did"
    },
    "trp_pay": {
      "type": "rust",
      "package": "trp_pay",
      "candid": "trp_pay/trp_pay.did"
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    },
    "canister_http": {
      "enabled": true
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    }
  }
}