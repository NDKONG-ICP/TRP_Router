type JobResult = variant { ok : nat64; err : text };
type MeterResult = variant { ok; err : text };

service : {
  init_meter : (nat32, nat64) -> (); // free_images_per_day, free_budget_tc_per_day (trillion cycles units = TC * 1e12? use raw TC as u64 * 1e12 simplified: pass TC as number * 1_000_000_000_000)
  set_router : (principal) -> ();
  deposit_cycles : () -> (nat64);
  credit_balance : () -> (nat) query;
  credit_balance_of : (principal) -> (nat) query;
  quote : (text) -> (record { credits : nat64; tier : text }) query;
  begin_job : (principal, text) -> (JobResult);
  settle_job : (nat64) -> (MeterResult);
  release_job : (nat64) -> (MeterResult);
  meter_status : () -> (
    record {
      free_budget_tc_remaining : nat64;
      global_free_spent_tc : nat64;
    }
  ) query;
};
